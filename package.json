{
  "name": "planner-design-api",
  "version": "1.19.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed.ts",
    "db:backup": "tsx --env-file-if-exists=.env src/db/backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env src/db/restore.ts",
    "sync-core": "node scripts/sync-core.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "dev:web": "vite --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@neondatabase/serverless": "^1.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@scalar/hono-api-reference": "^0.12.4",
    "@vercel/blob": "^2.8.0",
    "draco3dgltf": "^1.5.7",
    "drizzle-orm": "^0.45.3",
    "fflate": "^0.8.3",
    "hono": "^4.13.8",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "nodemailer": "^10.0.10",
    "openskp": "1.3.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "three": "^0.184.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
