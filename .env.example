# ─── Base de datos ───────────────────────────────────────────────
# Easypanel: usa la "Internal Connection URL" del servicio Postgres (p. ej. postgres://postgres:***@planner_db:5432/planner).
# Local con Docker:  postgres://planner:planner@localhost:5432/planner
# Local sin Docker:  pglite://./.data/pg   (Postgres embebido, solo desarrollo)
DATABASE_URL=postgres://planner:planner@localhost:5432/planner

# ─── Seguridad ───────────────────────────────────────────────────
# Secreto para firmar las URLs de subida y otros tokens internos. Mínimo 32 caracteres aleatorios.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ─── URLs ────────────────────────────────────────────────────────
# URL pública de esta API (con https en producción; la cookie se marca Secure automáticamente).
# Si sirves la API en el mismo dominio que el frontend bajo /api, usa ese dominio: https://tudominio.com
API_URL=http://localhost:3000
# Origen del frontend (CORS y enlaces de los correos). Sin barra final.
FRONTEND_URL=http://localhost:5173

# ─── Archivos ────────────────────────────────────────────────────
# Carpeta donde se guardan los archivos subidos (en Easypanel monta un volumen en /data).
UPLOADS_DIR=./.data/uploads
# Opcional: si defines un token de Vercel Blob, los archivos van a Vercel Blob en lugar del disco.
BLOB_READ_WRITE_TOKEN=

# ─── Correo (Resend) ─────────────────────────────────────────────
# Si falta RESEND_API_KEY, los correos se imprimen en la consola (y el código de registro no llega a nadie).
# MAIL_FROM debe ser una dirección de un dominio VERIFICADO en Resend; si no, Resend rechaza los envíos.
RESEND_API_KEY=
MAIL_FROM="Planner <no-reply@tudominio.com>"

# ─── Semilla (npm run db:seed) ───────────────────────────────────
SEED_ADMIN_EMAIL=admin@tudominio.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-larga
SEED_ADMIN_NAME=Administrador
SEED_ORG_NAME=Planner
SEED_ORG_SLUG=stephanny

# ─── Arranque ────────────────────────────────────────────────────
PORT=3000
# Aplica las migraciones pendientes al iniciar el servidor (la imagen Docker lo trae en true).
RUN_MIGRATIONS=false

# ─── Núcleo compartido ───────────────────────────────────────────
# Ruta al repo del frontend para  npm run sync-core
FRONTEND_REPO_PATH=../planner-frontend

# ─── Planes y pagos (Stripe) ────────────────────────────────────
# Los límites de plan se aplican siempre. Sin STRIPE_* no hay pago en línea: el plan lo asignan los administradores de la plataforma.
# Webhook: https://TU-DOMINIO/api/v1/billing/webhook con checkout.session.completed y customer.subscription.*
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Precios recurrentes creados en Stripe (price_…) para cada plan
STRIPE_PRICE_PROFESIONAL=
STRIPE_PRICE_EMPRESA=

# ─── Administradores de la plataforma ─────────────────────────────
# Correos (separados por coma) que ven todas las organizaciones y asignan planes en /plataforma. Deben tener cuenta con ese correo.
PLATFORM_ADMIN_EMAILS=
# Correo al que los clientes piden un cambio de plan (si falta, el primero de PLATFORM_ADMIN_EMAILS).
SUPPORT_EMAIL=

# ─── Tiendas de apps (docs/TIENDAS.md) ──────────────────────────
# App de Android (Play Store) vinculada a este dominio: paquete y huellas SHA-256 del certificado (separadas por coma).
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# ─── Respaldos (README → Respaldos y monitoreo) ─────────────────
# Carpeta donde el servidor guarda un respaldo de la base de datos cada BACKUP_INTERVAL_HOURS (vacío = apagado; Docker: /data/backups).
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_INTERVAL_HOURS=24

# Inicio de sesión con Google / Microsoft (opcional; cada botón aparece solo si están sus dos valores).
# URL de regreso: <API_URL>/api/v1/auth/oauth/google/callback y …/microsoft/callback. Ver README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common = cualquier cuenta de Microsoft; o el Id. de directorio para limitarlo a una empresa.
MICROSOFT_TENANT=common
